# Deploy module. Copy this file to .env.deploy and fill it in. See docs/deploy.md.
# Only the deploy worker reads this file: npm run deploy:worker

# The Google Cloud project that runs the deployed apps. Use the project ID, not the name or the number.
GCP_PROJECT_ID=

# Where the apps run. europe-north1 is Finland.
GCP_REGION=europe-north1

# Try the whole pipeline without calling Google Cloud: plan, build the folder, record the steps.
# Set it to 1 to test without a Google account.
DEPLOY_DRY_RUN=

# Path to the gcloud program. Leave it empty if `gcloud` works in your terminal.
GCLOUD_BIN=

# How the service is opened to the public.
#   allow-unauthenticated  - the normal way
#   no-invoker-iam-check   - use this if the first one is blocked by an organization policy
DEPLOY_PUBLIC_ACCESS=allow-unauthenticated

# Container size. 512Mi is enough for the reference apps.
DEPLOY_MEMORY=512Mi

# Set to 1 shortly before a live demo so the first visit does not wait for a cold start. It costs money while on.
DEPLOY_MIN_INSTANCES=0

# Keep at 1. The reference apps keep their SQLite database inside the container.
DEPLOY_MAX_INSTANCES=1

# How many deploys one worker runs at the same time.
DEPLOY_WORKER_CONCURRENCY=2
