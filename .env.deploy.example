# Deploy module. Copy this file to .env.deploy and fill it in. See docs/deploy.md.
# Only the deploy worker reads this file: npm run deploy:worker

# The Google Cloud project that runs the deployed apps. Use the project ID, not the name or the number.
GCP_PROJECT_ID=

# Where the apps run. europe-north1 is Finland.
GCP_REGION=europe-north1

# Try the whole pipeline without calling Google Cloud: plan, build the folder, record the steps.
# Set it to 1 to test without a Google account.
DEPLOY_DRY_RUN=

# Path to the gcloud program. Leave it empty if `gcloud` works in your terminal.
GCLOUD_BIN=

# How the service is opened to the public.
#   allow-unauthenticated  - the normal way
#   no-invoker-iam-check   - use this if the first one is blocked by an organization policy
DEPLOY_PUBLIC_ACCESS=allow-unauthenticated

# Who writes the app.
#   auto       - a model writes it from the canvas when GEMINI_API_KEY or OPENAI_API_KEY is set (in .env.local);
#                without a key, only SlotGuard can deploy, as its ready-made app (canvas edits are not applied)
#   agent      - always the model; fails without a key
#   reference  - always the ready-made app (SlotGuard only); no AI calls, no canvas edits
DEPLOY_BUILDER=auto

# Optional. The model for deploys alone, if it should differ from GEMINI_MODEL / OPENAI_MODEL.
# A stronger model writes better apps; it is also slower. Example: gemini-2.5-pro
DEPLOY_MODEL=

# Optional. The most the model may write in one answer. The defaults (60000 for Gemini, 32000 for OpenAI) suit most models.
DEPLOY_MAX_OUTPUT_TOKENS=

# Container size. 512Mi is enough for the generated apps.
DEPLOY_MEMORY=512Mi

# Set to 1 shortly before a live demo so the first visit does not wait for a cold start. It costs money while on.
DEPLOY_MIN_INSTANCES=0

# Keep at 1. The apps keep their SQLite database in memory inside the container.
DEPLOY_MAX_INSTANCES=1

# How many deploys one worker runs at the same time.
DEPLOY_WORKER_CONCURRENCY=2

# Save every release to a git repository, one branch per project, so projects are not lost with this machine.
# A new machine restores a project from there, and two people deploying the same project stay in step.
# Leave empty to keep everything on this machine only.
#   DEPLOY_GIT_REMOTE    an address `git push` understands, for example git@github.com:you/forma-projects.git
#   DEPLOY_GIT_SSH_KEY   private key to use for it. Optional; without it, your usual git login is used.
#                        The default is the shared example key committed in the project root. Replace it with
#                        your own key (outside the project, chmod 600) for anything that is not a demo.
DEPLOY_GIT_REMOTE=git@github.com:sadilet/forma-examples.git
DEPLOY_GIT_SSH_KEY=example_github_ssh
