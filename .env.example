# OpenAI — optional. Used when AI_PROVIDER=openai, or when Gemini is not configured.
# The key stays on the server and is never sent to the browser.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini

# Gemini — used by default when this key is set. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional. gemini or openai. Leave empty to use Gemini when GEMINI_API_KEY is set, otherwise OpenAI.
AI_PROVIDER=

# Gemini Live (voice and canvas vision). Uses GEMINI_API_KEY, which stays on the server.
# Locally: npm run voice:relay
# On Cloud Run: npm run cloud:deploy -- voice   (writes VOICE_RELAY_URL into .env.cloud automatically)
# Optional. Defaults to gemini-3.8-live.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional. Port the relay listens on locally. Defaults to 8787. Cloud Run uses $PORT instead.
VOICE_RELAY_PORT=8787
# Optional locally. On Cloud Run, cloud:deploy fills this with wss://…forma-voice…run.app for the web service.
VOICE_RELAY_URL=

# Context.dev — live company, people, news, and documentation lookups.
# The key stays on the server. https://context.dev
CONTEXT_DEV_API_KEY=

# Liveblocks — required for real-time collaboration across browsers.
# Create a project at https://liveblocks.io and paste the secret key.
# Without it, Forma runs as a solo canvas in this browser and says so.
LIVEBLOCKS_SECRET_KEY=

# Signs the session cookie. Override this outside a local demo.
SESSION_SECRET=forma-dev-session-secret

# Postgres. The default below matches `docker compose up -d db`, so locally you can leave it as it is.
# In Cloud Run it points at Cloud SQL through a socket (docs/cloud.md):
#   postgres://postgres:<password>@/forma?host=/cloudsql/<project>:<region>:<instance>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forma_local

# Optional. The product video beside the landing page headline. A direct video file (mp4, webm), a YouTube link, or a Vimeo link.
# Read when the page is served, so changing it needs a restart but no rebuild. Leave empty to hide the video.
PRODUCT_VIDEO_URL=

# Optional tldraw license. Without it, the canvas shows the tldraw watermark.
# https://tldraw.dev/community/license
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# export NVM_DIR="$HOME/.nvm" [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"