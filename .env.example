# OpenAI — optional. Used when AI_PROVIDER=openai, or when Gemini is not configured.
# The key stays on the server and is never sent to the browser.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini

# Gemini — used by default when this key is set. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional. gemini or openai. Leave empty to use Gemini when GEMINI_API_KEY is set, otherwise OpenAI.
AI_PROVIDER=

# Context.dev — live company, people, news, and documentation lookups.
# The key stays on the server. https://context.dev
CONTEXT_DEV_API_KEY=

# Liveblocks — required for real-time collaboration across browsers.
# Create a project at https://liveblocks.io and paste the secret key.
# Without it, Forma runs as a solo canvas in this browser and says so.
LIVEBLOCKS_SECRET_KEY=

# Signs the session cookie. Override this outside a local demo.
SESSION_SECRET=forma-dev-session-secret

# SQLite file. Defaults to data/forma.db
DATABASE_PATH=data/forma.db

# Optional tldraw license. Without it, the canvas shows the tldraw watermark.
# https://tldraw.dev/community/license
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# export NVM_DIR="$HOME/.nvm" [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"